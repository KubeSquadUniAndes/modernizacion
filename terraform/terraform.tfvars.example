aws_region      = "us-east-1"
aws_profile     = "universidad"
project         = "catalog"
environment     = "dev"
cluster_version = "1.33"
node_instance_type = "t3.small"
db_name         = "catalogdb"
db_username     = "catalogadmin"
# No hay variable db_password: RDS genera y guarda la master password
# directamente en Secrets Manager (manage_master_user_password = true, ver rds.tf).
